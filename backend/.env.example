# Copy to .env and fill in values.

# Passwords are stored with Argon2. Existing rows with older hash formats must reset passwords or re-register.

# Async SQLAlchemy URL (examples):
# DATABASE_URL=sqlite+aiosqlite:///./dev.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/rasar
DATABASE_URL=

# Comma-separated origins for CORS (empty = none).
ALLOWED_ORIGINS=

# JWT signing secret — use a long random string in production (32+ bytes entropy).
JWT_SECRET=
JWT_ALGORITHM=
JWT_ISS=
ACCESS_TOKEN_EXPIRES_SECONDS=
REFRESH_TOKEN_EXPIRES_SECONDS=
